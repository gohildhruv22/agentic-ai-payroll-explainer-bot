# Required
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_jwt_secret_change_this_in_production

# Optional — Groq models (defaults: llama-3.3-70b-versatile + llama-3.1-8b-instant).
# On 429 errors, wait a few minutes or use lighter models, e.g. both 8b instant:
# GROQ_MODEL=llama-3.1-8b-instant
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Optional - for web search features
SERPAPI_KEY=your_serpapi_key_here
NEWS_API_KEY=your_newsapi_key_here

# Database
DATABASE_URL=sqlite:///./payroll_bot.db

# App
APP_ENV=development
APP_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
